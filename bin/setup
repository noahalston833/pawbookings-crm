#!/usr/bin/env bash
# Installs backend gems + frontend packages and prepares the database.
# Safe to re-run at any time (idempotent), matching backend/bin/setup.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
  cp .env.example .env
  echo "==> Created .env from .env.example"
fi

echo "==> Backend: installing gems and preparing the database"
(cd backend && bin/setup --skip-server)

echo "==> Frontend: installing dependencies"
(cd frontend && npm install)

echo
echo "Setup complete. Run bin/dev to start the backend and frontend."
